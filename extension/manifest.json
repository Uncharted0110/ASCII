{
  "manifest_version": 3,
  "name": "ASCII Video Shader",
  "version": "0.2.0",
  "description": "Render videos on any webpage as live ASCII art with WebGPU.",
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "ASCII Video Shader"
  },
  "permissions": []
}
